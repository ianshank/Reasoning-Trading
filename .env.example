# =============================================================================
# Reasoning Trading - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Configuration
# -----------------------------------------------------------------------------
# OpenAI API (required for trading agents)
OPENAI_API_KEY=

# Anthropic API (optional, for Claude-based reasoning)
ANTHROPIC_API_KEY=

# LLM Model Selection (override defaults)
# Options: gpt-4o, gpt-4o-mini, o3-mini, claude-3-opus, claude-3-sonnet
DEEP_THINK_LLM=gpt-4o
QUICK_THINK_LLM=gpt-4o-mini

# -----------------------------------------------------------------------------
# Trading Platform Configuration
# -----------------------------------------------------------------------------
# Alpaca API Credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Mode: paper or live (ALWAYS start with paper!)
ALPACA_TRADING_MODE=paper

# -----------------------------------------------------------------------------
# Financial Data APIs
# -----------------------------------------------------------------------------
# Finnhub (stock data, news, fundamentals)
FINNHUB_API_KEY=

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=

# CoinDesk/CryptoCompare (cryptocurrency data)
COINDESK_API_KEY=

# -----------------------------------------------------------------------------
# MCTS Configuration
# -----------------------------------------------------------------------------
# Maximum number of MCTS simulations per decision
MCTS_MAX_SIMULATIONS=1000

# UCB exploration weight (higher = more exploration)
MCTS_EXPLORATION_WEIGHT=1.414

# Rollout horizon in trading days
MCTS_ROLLOUT_HORIZON_DAYS=30

# Confidence threshold for early termination
MCTS_CONFIDENCE_THRESHOLD=0.85

# Time budget for real-time MCTS (milliseconds)
MCTS_REALTIME_BUDGET_MS=500

# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
# Maximum position size as fraction of portfolio
MAX_POSITION_SIZE_FRACTION=0.25

# Default stop-loss percentage
DEFAULT_STOP_LOSS_PERCENT=0.05

# Maximum daily loss percentage (circuit breaker)
MAX_DAILY_LOSS_PERCENT=0.10

# Risk profiles: conservative, moderate, aggressive
DEFAULT_RISK_PROFILE=moderate

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Redis connection (for policy caching)
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Debate & Analysis Configuration
# -----------------------------------------------------------------------------
# Maximum rounds for Bull/Bear debate
MAX_DEBATE_ROUNDS=4

# Maximum rounds for risk discussion
MAX_RISK_DISCUSS_ROUNDS=3

# Enable parallel analyst execution
ENABLE_PARALLEL_ANALYSTS=true

# Enable online data tools
ENABLE_ONLINE_TOOLS=true

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging
LOG_JSON_FORMAT=false

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reasoning-trading

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
# REST API server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable short selling
ALLOW_SHORTS=false

# Enable margin trading
ENABLE_MARGIN_TRADING=false

# Enable cryptocurrency trading
ENABLE_CRYPTO_TRADING=true

# Enable automatic trade execution (disable for analysis-only mode)
AUTO_EXECUTE_TRADES=false
