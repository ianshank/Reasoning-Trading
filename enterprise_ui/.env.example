# Reasoning Trading Enterprise UI - Environment Configuration
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit .env with real credentials to version control

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
# Options: development, staging, production, test
ENVIRONMENT=development

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# Host and port for the FastAPI backend server
API_HOST=0.0.0.0
API_PORT=8000

# Number of worker processes (production only, use 1 for development)
# Recommended: (2 x CPU cores) + 1
API_WORKERS=4

# Auto-reload on code changes (development only, set to false in production)
API_RELOAD=true

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing
# CRITICAL: Generate a secure key with: openssl rand -hex 32
# DO NOT use the default in production!
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# JWT algorithm (HS256, HS384, HS512, RS256, etc.)
JWT_ALGORITHM=HS256

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Enable/disable CORS
CORS_ENABLED=true

# Allowed origins (comma-separated for multiple origins)
# Development example: http://localhost:3000,http://localhost:7860
# Production: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:80

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# RATE LIMITING
# =============================================================================
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per minute per client
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Burst allowance (temporary spikes above the rate limit)
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# Heartbeat/ping interval in seconds
WS_HEARTBEAT_INTERVAL_SECONDS=30

# Maximum WebSocket message size in bytes (1MB default)
WS_MAX_MESSAGE_SIZE_BYTES=1048576

# Connection timeout in seconds
WS_CONNECTION_TIMEOUT_SECONDS=300

# =============================================================================
# REDIS CACHE & PUB/SUB
# =============================================================================
# Redis server connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis password (leave empty if no password)
# IMPORTANT: Set a strong password in production
REDIS_PASSWORD=reasoningtrading

# Connection pool settings
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Cache TTL (time-to-live) in seconds
REDIS_DEFAULT_TTL=3600

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database URL (supports SQLite, PostgreSQL, MySQL, etc.)
# SQLite (development): sqlite:///./data/enterprise_ui.db
# PostgreSQL: postgresql://user:password@localhost:5432/reasoning_trading
DATABASE_URL=sqlite:///./data/enterprise_ui.db

# Echo SQL queries to console (debug only)
DATABASE_ECHO=false

# Connection pool settings (for PostgreSQL/MySQL)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# ALPACA TRADING API (REQUIRED)
# =============================================================================
# Alpaca API credentials
# Get yours at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Trading mode: true for paper trading (recommended for development/testing)
ALPACA_PAPER_TRADING=true

# Alpaca API base URLs (usually no need to change)
# ALPACA_BASE_URL=https://api.alpaca.markets
# ALPACA_DATA_URL=https://data.alpaca.markets

# =============================================================================
# LLM API KEYS (At least one required)
# =============================================================================
# OpenAI API Key (for GPT-4, GPT-3.5, etc.)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default LLM model to use
# Options: gpt-4, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet, etc.
DEFAULT_LLM_MODEL=gpt-4

# =============================================================================
# LANGCHAIN / LANGSMITH (OPTIONAL)
# =============================================================================
# LangSmith API key for tracing and monitoring (optional)
# Get yours at: https://smith.langchain.com/
LANGCHAIN_API_KEY=

# Enable LangSmith tracing
LANGCHAIN_TRACING_V2=false

# LangSmith project name
LANGCHAIN_PROJECT=reasoning-trading

# LangSmith endpoint (usually no need to change)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# FINNHUB API (OPTIONAL - for additional market data)
# =============================================================================
# Finnhub API key for market data
# Get yours at: https://finnhub.io/
FINNHUB_API_KEY=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production) or console (development)
LOG_FORMAT=console

# Log file paths (optional, logs to console if not set)
# LOG_FILE=logs/app.log
# LOG_ERROR_FILE=logs/error.log

# =============================================================================
# MCTS CONFIGURATION (Core Trading Settings)
# =============================================================================
# MCTS search parameters
MCTS_NUM_SIMULATIONS=100
MCTS_EXPLORATION_CONSTANT=1.414
MCTS_MAX_DEPTH=10

# MCTS timeout in seconds
MCTS_TIMEOUT_SECONDS=60

# Enable MCTS parallelization
MCTS_PARALLEL=true

# =============================================================================
# MARKET REGIME DETECTION
# =============================================================================
# Regime detection lookback period (days)
REGIME_LOOKBACK_DAYS=252

# Regime update frequency (seconds)
REGIME_UPDATE_FREQUENCY=3600

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Maximum position size as percentage of portfolio
MAX_POSITION_SIZE_PCT=10.0

# Maximum daily loss as percentage of portfolio
MAX_DAILY_LOSS_PCT=5.0

# Maximum portfolio leverage
MAX_LEVERAGE=2.0

# Enable risk checks before trading
RISK_CHECKS_ENABLED=true

# =============================================================================
# FRONTEND CONFIGURATION (Build-time variables)
# =============================================================================
# API base URLs for frontend
# Development: http://localhost:8000/api/v1
# Production: https://your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# Frontend environment mode
VITE_ENV=development

# Enable frontend debug mode
VITE_DEBUG=true

# =============================================================================
# DOCKER / NGINX CONFIGURATION
# =============================================================================
# Nginx port (only used in Docker deployment)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Python version for Docker build
PYTHON_VERSION=3.11

# Node version for Docker build
NODE_VERSION=18

# =============================================================================
# MONITORING & METRICS (OPTIONAL)
# =============================================================================
# Enable Prometheus metrics endpoint
METRICS_ENABLED=false

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable performance profiling
ENABLE_PROFILING=false

# Enable request tracing
ENABLE_TRACING=false
